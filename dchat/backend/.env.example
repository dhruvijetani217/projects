# Copy this file to ".env" (same folder) and fill in real values.

PORT=5000
MONGO_URI=mongodb://localhost:27017/dchat
# Use a long random string in production
JWT_SECRET=change_this_to_a_long_random_string

# Main admin login for the admin panel (http://localhost:5000/admin)
ADMIN_EMAIL=admin@dchat.com
ADMIN_PASSWORD=your_admin_password_here

# Secret key required to register a NEW admin from the admin panel.
# Leave empty to disable admin self-registration.
ADMIN_SECRET_KEY=change_this_secret_key

# Gmail SMTP for sending OTP emails (register verification + forgot password).
# GMAIL_USER is the Gmail address that SENDS the OTP mails (e.g. yourapp@gmail.com).
# GMAIL_APP_PASSWORD is NOT your normal Gmail password — generate a
# 16-character "App Password":
#   1. Go to https://myaccount.google.com/security
#   2. Turn on 2-Step Verification (required)
#   3. Go to "App passwords", create one for "Mail"
#   4. Paste the 16-char code below (no spaces)
# Without these, OTPs are only printed to the server console (useful for testing).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Max upload size in MB (default ~32GB)
MAX_UPLOAD_MB=32000
